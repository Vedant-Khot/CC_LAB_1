# Copy to .env and edit. .env is git-ignored.
#
# IMAGE_PREFIX is your Docker Hub namespace, i.e. the part before the slash in
# docker.io/<IMAGE_PREFIX>/registration-service:latest
IMAGE_PREFIX=yourhubusername

# IMAGE_TAG is optional, defaults to latest.
IMAGE_TAG=latest

# Docker Hub credentials are NOT stored here. Run `docker login` when prompted;
# the CLI keeps them in its own credential store, never in this repository.